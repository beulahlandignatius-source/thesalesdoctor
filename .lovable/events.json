{
  "schema_version": 1,
  "events": {
    "project.booking_completed": {
      "event_schema_version": 1,
      "description": "A visitor finished booking a session in the Calendly calendar on a booking page.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "type": "string",
            "enum": [
              "free_review",
              "private_clinic"
            ]
          }
        }
      }
    },
    "project.booking_started": {
      "event_schema_version": 1,
      "description": "A visitor picked a date and time in the Calendly calendar on a booking page.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "type": "string",
            "enum": [
              "free_review",
              "private_clinic"
            ]
          }
        }
      }
    },
    "project.consultation_booking_opened": {
      "event_schema_version": 1,
      "description": "A visitor clicked through to Calendly to pick a consultation time.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "type": "string",
            "enum": [
              "free_review",
              "private_clinic",
              "xray_followup"
            ]
          }
        }
      }
    },
    "project.consultation_whatsapp_clicked": {
      "event_schema_version": 1,
      "description": "A visitor clicked Continue to WhatsApp after successfully saving a free consultation enquiry; this is a handoff, not a confirmed appointment.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "type": "string",
            "enum": [
              "free_review"
            ]
          }
        }
      }
    },
    "project.enquiry_submitted": {
      "event_schema_version": 1,
      "description": "A visitor's free review, clinic or mentorship enquiry was saved.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "free_review",
              "private_clinic",
              "mentorship"
            ]
          }
        }
      }
    },
    "project.mentorship_enquiry_submitted": {
      "event_schema_version": 1,
      "description": "A mentorship enquiry was saved successfully, just before opening WhatsApp.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.payment_started": {
      "event_schema_version": 1,
      "description": "A visitor clicked a Private Sales Clinic pay button (Stripe USD or Flutterwave NGN).",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "stripe",
              "flutterwave"
            ]
          }
        }
      }
    },
    "project.review_moderated": {
      "event_schema_version": 1,
      "description": "An admin successfully approved a review using Publish or rejected/removed it using Hide.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          }
        }
      }
    },
    "project.review_published": {
      "event_schema_version": 1,
      "description": "An admin successfully changed a review to published, including republication after hiding; counts publications, not review views.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.review_submitted": {
      "event_schema_version": 1,
      "description": "A visitor review was successfully saved awaiting admin approval.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.service_whatsapp_clicked": {
      "event_schema_version": 1,
      "description": "A visitor clicked Ask on WhatsApp on a Services page offer.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service"
        ],
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "full_audit",
              "sales_funnel_engine",
              "mentorship",
              "other"
            ]
          }
        }
      }
    },
    "project.xray_completed": {
      "event_schema_version": 1,
      "description": "A visitor finished the Client X-Ray and their diagnosis was generated.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.xray_form_started": {
      "event_schema_version": 1,
      "description": "A visitor edits their first X-Ray contact field; once per mounted form, not on page view or later edits.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.xray_form_submitted": {
      "event_schema_version": 1,
      "description": "The final X-Ray form submission successfully saves all answers before opening results; does not imply diagnosis generation or payment.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.xray_report_downloaded": {
      "event_schema_version": 1,
      "description": "A visitor clicked to download their Client X-Ray PDF report.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    "project.xray_started": {
      "event_schema_version": 1,
      "description": "Fires when a visitor submits their details and begins the Client X-Ray questions.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    "project.xray_validation_error": {
      "event_schema_version": 1,
      "description": "An X-Ray contact field loses focus invalid or a required written answer loses focus empty.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "field",
          "reason"
        ],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "contact",
              "questions"
            ]
          },
          "field": {
            "type": "string",
            "enum": [
              "name",
              "email",
              "whatsapp",
              "answer"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "required",
              "invalid_format"
            ]
          }
        }
      }
    }
  }
}
